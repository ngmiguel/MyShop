# PostgreSQL
POSTGRES_USER=myshop
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=myshop
DATABASE_URL=postgresql://myshop:change_me_strong_password@postgres:5432/myshop

# JWT (same secret across all services)
JWT_SECRET=replace_with_64_char_random_hex
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Meilisearch
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=myshop_meili_master_key

# Service URLs (internal Docker network)
AUTH_SERVICE_URL=http://auth-service:3001
STORE_SERVICE_URL=http://store-service:3002
CATALOG_SERVICE_URL=http://catalog-service:3003
ORDER_SERVICE_URL=http://order-service:3004
SELLER_SERVICE_URL=http://seller-service:3005
USER_SERVICE_URL=http://user-service:3006
ANALYTICS_SERVICE_URL=http://analytics-service:3007

# Demo
DEMO_STORE_ID=
DEMO_MANAGER_EMAIL=manager@myshop.app
DEMO_MANAGER_PASSWORD=Manager2026!

# Gateway
GATEWAY_PORT=8080
